# Copy to .env and fill in. Do not commit .env (it is in .gitignore).
# Sections below: app, security, database, storage, LLM, transcription, TTS, retrieval, frontend.
# Required for minimal run: none (all have defaults). For RAG/voice clone/Co-DM, see optional vars.

# ---------- App (optional) ----------
# SERVER_NAME=0.0.0.0
# PORT=7862

# ---------- Security (optional) ----------
# Comma-separated API keys; header X-API-Key. Empty = no key required.
# API_KEYS=key1,key2
# REQUIRE_API_KEY=0
# Admin take-down key for DELETE /admin/voices/{id}. X-Admin-Key header.
# ADMIN_API_KEY=
# Max voice clones per IP per hour (0 = disable).
# ABUSE_CLONE_PER_IP_PER_HOUR=0

# ---------- Database (optional) ----------
# Voice metadata DB. SQLite or PostgreSQL URL. Empty = file-only metadata.
# DATABASE_URL=
# Example: sqlite:///voice_metadata.db

# ---------- Storage (optional) ----------
# VOICE_STORAGE_PATH=./voice_storage
# VOICE_STORAGE_BACKEND=local
# VOICE_STORAGE_BUCKET=
# AWS_REGION=us-east-1
# PENDING_CLONE_PATH=./pending_clones
# NARRATE_RESULT_PATH=./narrate_results
# CAMPAIGN_DOCUMENT_STORAGE_PATH=./campaign_documents

# ---------- TTS / voice clone (optional) ----------
# TTS_PROVIDER=kani
# AUDIO_CACHE_SIZE=10
# CLONE_MIN_DURATION_SEC=3
# CLONE_MAX_DURATION_SEC=60
# VOICE_RETENTION_DAYS=0
# HUME_API_KEY=
# HUME_SECRET_KEY=
# HUME_BASE_URL=https://api.hume.ai
# HUME_TTS_VERSION=2

# ---------- Rate limits & CORS (optional) ----------
# RATE_LIMIT_GLOBAL=60/minute
# RATE_LIMIT_TTS=30/minute
# RATE_LIMIT_CLONE=10/minute
# CORS_ORIGINS=

# ---------- LLM (required for Co-DM / adventure parse / NPC) ----------
# Anthropic API key — used for Claude intent routing and responses.
# Create at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-4-5-20251001
# MAX_ADVENTURE_CHARS=160000

# ---------- Transcription (required for live Co-DM mic) ----------
# Deepgram API key — used by /ws/audio when mic chunks are finalized.
# DEEPGRAM_API_KEY=...
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en-US
# AUTO_QUERY_ON_VOICE=1

# ---------- Retrieval / RAG (required for RAG query and ingest) ----------
# OPENAI_API_KEY=sk-...
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX_NAME=co-dm-index
# EMBEDDING_MODEL=text-embedding-3-small

# ---------- Voice cloning model (optional) ----------
# Hugging Face token — KaniTTS-2 models are public; set if using gated assets.
# HF_TOKEN=hf_...

# ---------- Background jobs (optional, production) ----------
# Redis URL for async clone/narrate. Set to enable job_id and polling.
# CELERY_BROKER_URL=redis://localhost:6379/0
