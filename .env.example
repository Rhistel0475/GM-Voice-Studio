# Copy to .env and fill in. Do not commit .env (it is in .gitignore).

# Hugging Face token (optional — KaniTTS-2 models are public, no token required).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Co-DM RAG pipeline (Sprint 2)
# OpenAI API key — used for text-embedding-3-small embeddings.
# Create at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Pinecone API key — vector database for campaign knowledge.
# Create a free account at https://app.pinecone.io and generate an API key.
# PINECONE_API_KEY=pcsk_...

# Pinecone index name (must be created manually with 1536 dims, cosine metric).
# PINECONE_INDEX_NAME=co-dm-index

# Co-DM LLM brain (Sprint 3)
# Anthropic API key — used for Claude (claude-haiku-4-5) intent routing and responses.
# Create at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
